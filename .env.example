# Copy to .env (or set these in your host's dashboard) before running in production.

# Listen port. Optional — defaults to 3000.
PORT=3000

# Required to enable /admin. Without it, every login attempt is refused by design.
# 12+ characters recommended; a startup warning fires if shorter.
ADMIN_PASSWORD=

# Recommended. Without it a random secret is generated per boot, so admin
# sessions survive only until the next restart.
SESSION_SECRET=

# Recommended in production: secure cookies + 7-day static-asset caching.
NODE_ENV=production

# Canonical origin used for canonical URLs, Open Graph tags, and sitemap.xml.
BASE_URL=https://www.massifyx.com

# MassifyX Intelligence Service (MIS) — the separate disruption-monitor
# microservice /live reads from server-side. Without it, /live still returns
# 200 with a "temporarily unavailable" panel; nothing else on the site
# depends on this.
MIS_BASE_URL=

# War Room investigation service — the separate deep-agent microservice
# /live's "Investigate" action proxies to server-side. Without it, the
# action still renders (once unlocked) but the investigation kick-off/poll
# routes report "unavailable" instead of erroring.
WARROOM_BASE_URL=

# Shared access code that unlocks the "Investigate" action on /live for a
# browser session. Same shape as ADMIN_PASSWORD: without it, /live/unlock
# refuses every attempt and the action stays in its locked teaser state for
# everyone. Given out manually after a sales conversation, not self-serve.
WARROOM_ACCESS_CODE=

# Contact form delivery. Without SMTP_HOST set, submissions are only logged to
# stdout — nothing is emailed, and the admin dashboard checklist shows this
# item as not done. All contact-page fields still work either way; this only
# controls whether a notification email goes out.
SMTP_HOST=
SMTP_PORT=587
# Set to "true" for a TLS connection on connect (typically port 465).
# Leave unset/false for STARTTLS on 587, the more common setup.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From-address the notification email is sent as. Defaults to
# "<site publicName> website" <no-reply@your-inbox's-domain> if unset.
SMTP_FROM=
# Inbox that receives contact-form notifications. Defaults to site.contactEmail
# (edit that in the admin panel under Site) if unset.
CONTACT_TO_EMAIL=
