<section class="hero">
  <img class="hero__bg" src="/img/generated-data-tunnel.jpg" alt="" aria-hidden="true" width="2752" height="1536">
  <div class="hero__spotlight" aria-hidden="true"></div>
  <div class="shell hero__grid">
    <%# Copy comes first in DOM order: a visitor should read what the company does
        before meeting an abstract graphic of it. %>
    <div class="hero__copy">
      <span class="eyebrow"><%= page.hero.eyebrow %></span>
      <h1 class="display-1"><%= page.hero.headline %></h1>
      <p class="lede hero__body"><%= page.hero.body %></p>
      <div class="btn-row">
        <a class="btn btn--primary" href="<%= page.hero.primaryCta.href %>"><%= page.hero.primaryCta.label %></a>
        <a class="btn btn--ghost" href="<%= page.hero.secondaryCta.href %>"><%= page.hero.secondaryCta.label %></a>
      </div>
    </div>
    <div class="hero__figure">
      <% if (page.hero.figureImage) { %>
        <img src="<%= page.hero.figureImage %>" alt="" width="660" height="520">
      <% } else { %>
        <%- include('partials/hero-figure') %>
      <% } %>
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="shell">
    <div class="factbar">
      <% page.valueProps.forEach(function (vp) { %>
        <div class="factbar__item reveal">
          <h2 class="factbar__title"><%= vp.title %></h2>
          <p class="factbar__body"><%= vp.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%# Full-bleed motion band: the supply-chain thesis in one moving image. %>
<section class="motion-band" aria-hidden="true">
  <img src="<%= page.motionBand.image %>" alt="" width="1600" height="420" loading="lazy">
</section>

<%# Problem — the situation a mid-market procurement lead recognises. %>
<section class="section">
  <div class="shell shell--narrow">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.problem.eyebrow %></span>
      <h2 class="display-2"><%= page.problem.headline %></h2>
    </div>
    <ul class="capability-list capability-list--lead reveal">
      <% page.problem.points.forEach(function (p) { %>
        <li><%= p %></li>
      <% }); %>
    </ul>
  </div>
</section>

<%# Insight — the reframe. %>
<section class="section section--alt">
  <div class="shell shell--narrow">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.insight.eyebrow %></span>
      <h2 class="display-2"><%= page.insight.headline %></h2>
      <p class="lede"><%= page.insight.body %></p>
    </div>
  </div>
</section>

<%# Solution — three small, bounded ways in. %>
<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.solution.eyebrow %></span>
      <h2 class="display-2"><%= page.solution.headline %></h2>
      <p class="lede"><%= page.solution.body %></p>
    </div>

    <div class="grid grid--3">
      <% page.solution.items.forEach(function (item) { %>
        <div class="card reveal">
          <h3 class="card__title"><%= item.name %></h3>
          <p class="card__body"><%= item.body %></p>
        </div>
      <% }); %>
    </div>

    <p class="lede reveal" style="margin-top:2.5rem;"><%= page.solution.thenWeRunIt %></p>
    <div style="margin-top:1.5rem;">
      <a class="arrow-link" href="<%= page.solution.cta.href %>"><%= page.solution.cta.label %></a>
    </div>
  </div>
</section>

<%# Engagement — See. Steady. Sharpen. Scale. The fourth stage is the point. %>
<section class="section section--alt">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.engagement.eyebrow %></span>
      <h2 class="display-2"><%= page.engagement.headline %></h2>
    </div>

    <div class="steps steps--4">
      <% page.engagement.steps.forEach(function (step) { %>
        <div class="step reveal">
          <div class="step__number"><%= step.number %></div>
          <h3 class="step__title"><%= step.title %></h3>
          <p class="step__body"><%= step.body %></p>
        </div>
      <% }); %>
    </div>

    <p class="lede reveal" style="margin-top:2.5rem;"><%= page.engagement.note %></p>
  </div>
</section>

<%# Model — the Sweden / Colombo split, with the honest comparison. %>
<section class="section">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.model.eyebrow %></span>
      <h2 class="display-2"><%= page.model.headline %></h2>
    </div>

    <div class="split">
      <% page.model.panels.forEach(function (panel) { %>
        <article class="panel panel--plain reveal">
          <div class="panel__inner">
            <span class="panel__label"><%= panel.label %></span>
            <p class="panel__body"><%= panel.body %></p>
          </div>
        </article>
      <% }); %>
    </div>

    <p class="lede reveal" style="margin-top:2rem;"><%= page.model.note %></p>

    <div class="table-scroll reveal" style="margin-top:2.5rem;">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">&nbsp;</th>
            <th scope="col"><%= page.model.comparison.colLeft %></th>
            <th scope="col"><%= page.model.comparison.colRight %></th>
          </tr>
        </thead>
        <tbody>
          <% page.model.comparison.rows.forEach(function (row) { %>
            <tr>
              <td><%= row.criterion %></td>
              <td><%= row.left %></td>
              <td><%= row.right %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# Industries preview strip. %>
<section class="section section--alt">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.industriesStrip.eyebrow %></span>
      <h2 class="display-2"><%= page.industriesStrip.headline %></h2>
      <p class="lede"><%= page.industriesStrip.body %></p>
    </div>

    <div class="grid grid--4">
      <% industries.items.forEach(function (ind) { %>
        <a class="card card--link reveal" href="/industries#<%= ind.slug %>">
          <span class="card__icon">
            <% if (ind.icon) { %>
              <img src="<%= ind.icon %>" alt="">
            <% } else { %>
              <%- include('partials/industry-icon', { slug: ind.slug }) %>
            <% } %>
          </span>
          <h3 class="card__title" style="font-size:1.06rem;"><%= ind.name %></h3>
        </a>
      <% }); %>
    </div>

    <div style="margin-top:2.5rem;">
      <a class="arrow-link" href="<%= page.industriesStrip.cta.href %>"><%= page.industriesStrip.cta.label %></a>
    </div>
  </div>
</section>

<%# Proof — checkable, not claimed. Points at the founder grid and Signal. %>
<section class="section">
  <div class="shell shell--narrow">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.proof.eyebrow %></span>
      <h2 class="display-2"><%= page.proof.headline %></h2>
      <p class="lede"><%= page.proof.body %></p>
    </div>
    <div style="margin-top:1.5rem;">
      <a class="arrow-link" href="<%= page.proof.cta.href %>"><%= page.proof.cta.label %></a>
    </div>
  </div>
</section>

<%# Security posture — the honest in-place / not-yet-true split, condensed so a
    visitor meets it before the closing CTA. %>
<section class="section section--alt">
  <div class="shell">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.posture.eyebrow %></span>
      <h2 class="display-2"><%= page.posture.headline %></h2>
      <p class="lede"><%= page.posture.body %></p>
    </div>

    <div class="split">
      <article class="panel panel--plain reveal">
        <div class="panel__inner">
          <span class="panel__label"><%= page.posture.inPlaceLabel %></span>
          <ul class="posture-list posture-list--yes">
            <% page.posture.inPlace.forEach(function (i) { %>
              <li><%= i %></li>
            <% }); %>
          </ul>
        </div>
      </article>
      <article class="panel panel--plain panel--roadmap reveal">
        <div class="panel__inner">
          <span class="panel__label"><%= page.posture.roadmapLabel %></span>
          <ul class="posture-list posture-list--no">
            <% page.posture.roadmap.forEach(function (i) { %>
              <li><%= i %></li>
            <% }); %>
          </ul>
        </div>
      </article>
    </div>

    <div style="margin-top:2.5rem;">
      <a class="arrow-link" href="<%= page.posture.cta.href %>"><%= page.posture.cta.label %></a>
    </div>
  </div>
</section>

<%# Founder teaser — the credibility grid lives on Who We Are; this is the
    checkable summary in front of the closing CTA. %>
<section class="section">
  <div class="shell shell--narrow">
    <div class="section-head reveal">
      <span class="eyebrow"><%= page.founder.eyebrow %></span>
      <h2 class="display-2"><%= page.founder.headline %></h2>
    </div>
    <ul class="capability-list reveal">
      <% page.founder.credentials.forEach(function (c) { %>
        <li><%= c %></li>
      <% }); %>
    </ul>
    <p class="reveal" style="margin-top:1.5rem;">
      <strong><%= page.founder.name %></strong> · <span class="muted"><%= page.founder.role %></span>
    </p>
    <div style="margin-top:1.25rem;">
      <a class="arrow-link" href="<%= page.founder.cta.href %>"><%= page.founder.cta.label %></a>
    </div>
  </div>
</section>

<%- include('partials/cta-band', { closing: page.closing }) %>
