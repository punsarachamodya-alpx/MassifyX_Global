<h1>Backups</h1>
<p class="amuted">
  A snapshot is taken automatically before every save, reset, and restore. The most recent
  30 are kept. Restoring backs up the current state first, so a restore is itself reversible.
</p>

<% if (flash === 'restored') { %>
  <p class="anotice anotice--ok">Backup restored.</p>
<% } %>

<div class="acard" style="margin-top:1.5rem;">
  <% if (!backups.length) { %>
    <p class="amuted">No backups yet — they appear here after your first save.</p>
  <% } else { %>
    <table class="atable">
      <thead><tr><th>Snapshot</th><th>Taken</th><th></th></tr></thead>
      <tbody>
        <% backups.forEach(function (b) { %>
          <tr>
            <td><code><%= b.name %></code></td>
            <td><%= b.mtime.toISOString().replace('T', ' ').slice(0, 19) %> UTC</td>
            <td style="text-align:right;">
              <form method="post" action="/admin/backups/restore" data-confirm="Restore this backup? The current content is backed up first.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="name" value="<%= b.name %>">
                <button type="submit" class="abtn abtn--quiet">Restore</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
