<section class="cta-band">
  <img class="cta-band__mark" src="/brand/massifyx-x-mark.png" alt="" aria-hidden="true" width="600" height="537">
  <div class="shell cta-band__inner">
    <div>
      <h2 class="cta-band__title"><%= closing.headline %></h2>
      <p class="cta-band__body"><%= closing.body %></p>
    </div>
    <div>
      <a class="btn btn--onNavy" href="<%= closing.cta.href %>"><%= closing.cta.label %></a>
    </div>
  </div>
</section>
