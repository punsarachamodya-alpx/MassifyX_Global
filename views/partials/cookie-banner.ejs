<div class="cookie-banner" id="cookieBanner" role="region" aria-label="Cookie preferences" hidden>
  <div class="shell cookie-banner__inner">
    <p class="cookie-banner__text">
      We use only the cookies this site needs to work. No analytics tool is currently connected and
      nothing here tracks you across other sites. Read our <a href="/cookies">Cookie Policy</a>.
    </p>
    <div class="cookie-banner__actions">
      <button type="button" class="btn btn--primary" id="cookieAccept">Accept</button>
      <button type="button" class="btn btn--ghost" id="cookieReject">Reject</button>
      <a class="btn btn--ghost" href="/cookies">Manage</a>
    </div>
  </div>
</div>
