<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= meta && meta.title ? meta.title : site.publicName %></title>
  <meta name="description" content="<%= meta && meta.description ? meta.description : site.description %>">
  <link rel="canonical" href="<%= canonical %>">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site.publicName %>">
  <meta property="og:title" content="<%= meta && meta.title ? meta.title : site.publicName %>">
  <meta property="og:description" content="<%= meta && meta.description ? meta.description : site.description %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= site.baseUrl %>/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= meta && meta.title ? meta.title : site.publicName %>">
  <meta name="twitter:description" content="<%= meta && meta.description ? meta.description : site.description %>">
  <meta name="twitter:image" content="<%= site.baseUrl %>/og-image.png">

  <meta name="theme-color" content="#0a1b3c">
  <%# SVG favicon for browsers that support scalable tab icons; PNG fallbacks
      (regenerated from the same source SVG) for everyone else, and Apple touch
      icon specifically — Safari doesn't accept SVG there. %>
  <link rel="icon" href="/brand/massifyx-x-mark.svg" type="image/svg+xml">
  <link rel="icon" href="/brand/favicon-32.png" sizes="32x32">
  <link rel="icon" href="/brand/favicon-256.png" sizes="256x256">
  <link rel="apple-touch-icon" href="/brand/apple-icon-180.png">

  <link rel="preload" href="/fonts/manrope-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/montserrat-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/styles.css">
  <%
    // Admin-editable sizing (Appearance section). Parsed with a fallback to the
    // shipped defaults, so a blank or corrupted value can never break layout.
    const logoH = parseInt(appearance.logoHeaderHeight, 10) || 56;
    const footerLogoH = parseInt(appearance.logoFooterHeight, 10) || 52;
    const iconSize = parseInt(appearance.industryIconSize, 10) || 44;

    // Mobile screen width doesn't grow with a bigger desktop logo choice, so
    // phone sizing is capped at a fixed, separately-verified-safe height rather
    // than scaled as a fraction of the desktop value. 40px measured well next to
    // the hamburger button down to a 320px-wide phone; a straight percentage of
    // a large desktop value (e.g. 112px) would overflow narrow screens instead
    // of just rendering smaller. min() also means a deliberately tiny desktop
    // logo is never blown back up on mobile.
    const MOBILE_LOGO_CAP = 40;
    const logoHMobile = Math.min(MOBILE_LOGO_CAP, logoH);
    const footerLogoHMobile = Math.min(MOBILE_LOGO_CAP, footerLogoH);

    // The wordmark's own viewBox (public/brand/massifyx-lockup-light.svg) —
    // its true aspect ratio, straight from the source vector.
    const LOGO_ASPECT = 1233.1688 / 183.2357;
    const desktopLogoWidth = logoH * LOGO_ASPECT;

    // How much room the 5 nav links + CTA button + gutters need beside the logo
    // to fit on one line, measured in a real browser at two logo sizes and
    // solved for the constant: breakpoint = logoWidth + ~915px, with a small
    // safety margin added here. A fixed pixel breakpoint (the previous approach)
    // only holds for the logo size and aspect ratio it was measured at — this
    // one holds for whatever the admin sets, including much larger values.
    const NAV_ROOM = 930;
    const navBreakpoint = Math.ceil(desktopLogoWidth + NAV_ROOM);
  %>
  <style>
    <%# object-fit: contain matters here, not just cosmetically: the footer's
        fr-based grid column is often narrower than this logo's natural width at
        a large configured height (confirmed: a 507px column vs. a 701px natural
        width at the 104px default on a 1440px viewport). Once the global
        `img { max-width: 100% }` rule caps the width AND height is separately
        fixed in px, both dimensions count as "definite" to the browser —
        aspect-ratio alone doesn't reconcile two already-definite dimensions, it
        only fills in a dimension that's still auto, so it silently doesn't help
        here and the image stretches non-uniformly (Chromium confirmed via
        getComputedStyle: aspect-ratio was correctly set, box size still didn't
        honor it). object-fit: contain fixes it at the paint step instead: the
        content scales proportionally within whatever box results, never
        stretched, at the cost of possibly not filling the box exactly. Applied
        to the header logo too as a no-cost safety net. %>
    :root { --logo-h: <%= logoH %>px; --header-h: calc(var(--logo-h) + 44px); }
    .header__logo img { aspect-ratio: <%= LOGO_ASPECT %>; object-fit: contain; }
    .footer__logo img {
      height: <%= footerLogoH %>px;
      aspect-ratio: <%= LOGO_ASPECT %>;
      object-fit: contain;
    }
    .card__icon { width: <%= iconSize %>px; height: <%= iconSize %>px; }
    <%# See the comment above navBreakpoint: this is not a fixed value because a
        wider admin-set logo needs a wider viewport before the nav fits on one
        line. Also carries the full hamburger-mode ruleset — CSS media queries
        can't reference a custom property, so this can't just override a
        breakpoint declared in styles.css; the whole thing has to live here. %>
    @media (max-width: <%= navBreakpoint %>px) {
      :root { --logo-h: <%= logoHMobile %>px; --header-h: calc(var(--logo-h) + 36px); }

      .header__toggle { display: flex; }

      .header__nav {
        position: fixed;
        inset: var(--header-h) 0 auto 0;
        background: #fff;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: 1rem var(--gutter) 2rem;
        border-bottom: 1px solid var(--rule);
        box-shadow: 0 24px 40px -28px rgba(10, 27, 60, 0.4);
        display: none;
      }

      .header__nav.is-open { display: flex; }

      .header__link {
        padding-block: 0.95rem;
        border-bottom: 1px solid var(--rule);
        font-size: 1.05rem;
      }

      .header__link::after { display: none; }

      .header__cta { margin: 1.25rem 0 0; text-align: center; }
    }
    <%# The footer has its own, narrower breakpoint (see .footer__grid in
        styles.css) where it drops to a single column — that's when a large
        footer logo would otherwise overflow, so the cap applies from there. %>
    @media (max-width: 820px) {
      .footer__logo img { height: <%= footerLogoHMobile %>px; }
    }
  </style>
  <%# Sets the .js flag before first paint so scroll-reveal can hide content only
      when JavaScript is actually available. External, never inline: script-src is 'self'. %>
  <script src="/js/js-on.js"></script>

  <script type="application/ld+json">
    <%- JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.publicName,
      legalName: site.legalEntity,
      description: site.description,
      email: site.contactEmail,
      url: site.baseUrl,
      logo: site.baseUrl + '/brand/massifyx-lockup-light.svg',
      sameAs: [site.linkedinUrl].filter(Boolean)
    }) %>
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <%- include('partials/header') %>
  <main id="main">
    <%- body %>
  </main>
  <%- include('partials/footer') %>
  <%- include('partials/cookie-banner') %>
  <script src="/js/main.js" defer></script>
</body>
</html>
